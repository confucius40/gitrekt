cabal-version:      3.0
name:               gitrekt
version:            0.1.0.0
license:            AGPL-3.0-only
author:             confucius40
maintainer:         confu@gitrekt.local
build-type:         Simple

executable gitrekt
  main-is:          Main.hs
  build-depends:
      base >=4.16 && <5
    , wai >=3.2
    , warp >=3.3
    , wai-cors >=0.2
    , servant >=0.19
    , servant-server >=0.19
    , aeson >=2.0
    , bytestring >=0.11
    , text >=1.2
    , sqlite-simple >=0.4
    , cryptohash-sha256 >=0.11
    , base16-bytestring >=1.0
    , time >=1.9
    , filepath >=1.4
    , directory >=1.3
  hs-source-dirs:   app
  default-language: Haskell2010
  ghc-options:      -Wall -O2 -threaded
